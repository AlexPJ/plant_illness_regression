{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "https://plant-illness-regression-338441810170.us-central1.run.app",
          "region": "us-central1" 
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
